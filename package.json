{
  "name": "arms-client",
  "version": "1.0.0",
  "description": "Arm client for Arms v1 (bonded checking protocol) on Sepolia: reader, source fetcher, agent skill, CLI, live run",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "arms": "dist/arms.mjs" },
  "scripts": {
    "build": "node scripts/build.mjs",
