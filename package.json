    "fixtures": "node scripts/build-fixtures.mjs"
  },
  "dependencies": { "viem": "^2.21.0" },
  "devDependencies": { "esbuild": "^0.25.0", "typescript": "^5.6.0", "@types/node": "^20.0.0" }
}
